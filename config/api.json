{
  "_comment": "Template konfigurasi API — isi dengan data lo, JANGAN push ke GitHub publik!",
  "_warning": "Simpan file ini di .gitignore jika berisi API key asli",
  "roblox": {
    "api_key": "",
    "user_id": "",
    "group_id": "",
    "proxy_url": "",
    "use_group_uploader": false,
    "endpoints": {
      "assets": "https://apis.roblox.com/assets/v1/assets",
      "users":  "https://users.roblox.com/v1/users",
      "groups": "https://groups.roblox.com/v1/groups"
    },
    "headers": {
      "x-api-key": "{{API_KEY}}",
      "Content-Type": "application/json"
    }
  },
  "settings": {
    "auto_upload_after_spoof": false,
    "randomize_asset_name": true,
    "verbose_logging": true,
    "request_timeout_ms": 10000,
    "upload_delay_ms": 1200,
    "asset_name_prefix": "AL_STUDIO_"
  }
}
