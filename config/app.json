{
  "app": {
    "name": "AL STUDIO Asset Spoofer",
    "version": "2.0.0",
    "author": "AL STUDIO",
    "github": "https://github.com/al-studio70/al-studio-spoofer"
  },
  "ui": {
    "theme": "dark-blue-rgb",
    "primary_color": "#005eff",
    "accent_color": "#00e5ff",
    "font_display": "Rajdhani",
    "font_body": "Inter",
    "font_mono": "JetBrains Mono"
  },
  "spoofer": {
    "default_delay_ms": 400,
    "max_delay_ms": 1000,
    "max_ids_per_session": 5000,
    "supported_types": [
      "audio",
      "animation",
      "image",
      "model"
    ],
    "supported_input_formats": [
      ".txt",
      ".csv"
    ],
    "supported_export_formats": [
      ".rbxm",
      ".rbxl"
    ]
  },
  "uploader": {
    "default_delay_ms": 1200,
    "min_delay_ms": 500,
    "request_timeout_ms": 10000,
    "supported_file_types": [
      ".rbxm",
      ".mp3",
      ".ogg",
      ".png",
      ".jpg",
      ".jpeg",
      ".gif"
    ],
    "roblox_api_endpoint": "https://apis.roblox.com/assets/v1/assets",
    "roblox_api_version": "v1"
  },
  "export": {
    "default_name": "AL_STUDIO_ASSETS",
    "include_audio": true,
    "include_animation": true,
    "include_metadata": true,
    "rbxm_version": "4"
  }
}
