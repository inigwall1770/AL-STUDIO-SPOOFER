{
  "asset_types": {
    "audio": {
      "label": "Audio",
      "emoji": "🎵",
      "roblox_class": "Sound",
      "roblox_property": "SoundId",
      "prefix": "rbxassetid://",
      "accepted_files": [".mp3", ".ogg"],
      "max_size_mb": 20,
      "rbxm_template": "<Item class=\"Sound\"><Properties><string name=\"Name\">{name}</string><Content name=\"SoundId\">rbxassetid://{id}</Content><bool name=\"Looped\">false</bool><float name=\"Volume\">1</float><bool name=\"Playing\">false</bool></Properties></Item>"
    },
    "animation": {
      "label": "Animation",
      "emoji": "🎭",
      "roblox_class": "Animation",
      "roblox_property": "AnimationId",
      "prefix": "rbxassetid://",
      "accepted_files": [".rbxm"],
      "max_size_mb": 50,
      "rbxm_template": "<Item class=\"Animation\"><Properties><string name=\"Name\">{name}</string><Content name=\"AnimationId\">rbxassetid://{id}</Content></Properties></Item>"
    },
    "image": {
      "label": "Image / Decal",
      "emoji": "🖼️",
      "roblox_class": "Decal",
      "roblox_property": "Texture",
      "prefix": "rbxassetid://",
      "accepted_files": [".png", ".jpg", ".jpeg", ".gif"],
      "max_size_mb": 10,
      "rbxm_template": "<Item class=\"Decal\"><Properties><string name=\"Name\">{name}</string><Content name=\"Texture\">rbxassetid://{id}</Content></Properties></Item>"
    },
    "model": {
      "label": "Model",
      "emoji": "🧱",
      "roblox_class": "Model",
      "roblox_property": "Name",
      "prefix": "",
      "accepted_files": [".rbxm"],
      "max_size_mb": 100,
      "rbxm_template": "<Item class=\"Model\"><Properties><string name=\"Name\">{name}</string></Properties></Item>"
    }
  },
  "rbxm_wrapper": {
    "header": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<roblox xmlns:xmime=\"http://www.w3.org/2005/05/xmlmime\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:noNamespaceSchemaLocation=\"http://www.roblox.com/roblox.xsd\" version=\"4\">",
    "footer": "</roblox>",
    "sound_service_open": "<Item class=\"SoundService\"><Properties><string name=\"Name\">SoundService</string></Properties>",
    "sound_service_close": "</Item>",
    "folder_open": "<Item class=\"Folder\"><Properties><string name=\"Name\">{folder_name}</string></Properties>",
    "folder_close": "</Item>"
  }
}
